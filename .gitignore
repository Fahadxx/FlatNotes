node_modules/
dist/

# Your notes never live here. The app writes every document, the window state and the
# OneNote import staging area to Electron's userData directory (%APPDATA%\FlatNotes), and
# the OCR/ASR engines and their models to %LOCALAPPDATA%\FlatNotes. Nothing below is data
# in that sense; these are build outputs and test artefacts that land inside the checkout
# and would otherwise be committed by accident.

# compiled OneNote COM helper: setup-onenote.ps1 can build it here for a dev run, and
# electron/main.cjs looks for it at onenote/bin before the installed copy
onenote/bin/
onenote/obj/

# engine logs, self-test output and headless-eval dumps
*.log
*.out.json
selftest-*.json
selftest-*.png

# packed archives and the rollback copy update-app.ps1 leaves behind
*.asar
*.asar.bak

# Python. The app itself ships no Python, but the README's browser mode runs
# `python -m http.server` inside app/, and throwaway analysis or tooling scripts tend to
# land in a checkout sooner or later. Note that `build/` is deliberately NOT ignored here,
# unlike in a stock Python .gitignore: build/icon.png is a real tracked asset that
# electron-builder needs.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
